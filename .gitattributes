# Keep development-only files out of the archive Composer builds for consumers.
#
# Everything listed here stays in git and stays available to anyone who clones the
# repo. It simply never reaches the `vendor/anchovyx/craft-secure-backups` directory
# of a site that runs `composer require`, which keeps installs small and stops CI
# config, linter config and internal notes shipping to production.

/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/dev                export-ignore
/tests              export-ignore
/ecs.php            export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/CLAUDE.md          export-ignore
